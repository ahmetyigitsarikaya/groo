# Application
APP_NAME=Groo
# Use "production" and APP_DEBUG=false in live deployments
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=Europe/Istanbul
# Leave empty when serving from document root, or set e.g. /groo for a subdirectory
APP_BASE_PATH=
APP_INSTALLED=false

# Database (MySQL / MariaDB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=groo
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Plugins & Migrations
# Set AUTO_MIGRATE=false in production after initial setup
AUTO_MIGRATE=true
# Comma-separated active plugin slugs. Do NOT leave blank in production (blank auto-loads all plugins, including demo/install).
ACTIVE_PLUGINS=admin,content,crm,usermanagement,traffic,seo,errorpages,media

# Active Frontend Template
ACTIVE_TEMPLATE=default

# Admin Panel URL Segment (no leading slash)
ADMIN_PATH=admin
